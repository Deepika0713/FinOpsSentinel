# Groq API key used by the LLM auditor.
GROQ_API_KEY=your_groq_api_key_here

# Azure subscription used for scanning and remediation.
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id_here

# Optional service-principal credentials for non-interactive environments.
# AZURE_CLIENT_ID=your_client_id_here
# AZURE_TENANT_ID=your_tenant_id_here
# AZURE_CLIENT_SECRET=your_client_secret_here
